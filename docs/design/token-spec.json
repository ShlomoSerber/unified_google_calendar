{
  "_note": "Read by scripts/measure/extract-tokens.mjs. Node indexes refer to scripts/measure/tree.mjs output of the named dump.",
  "set": {
    "font.source": "measurements/gm3-light.json (roles) — effective families on calendar.google.com",
    "font.family_body": "\"Google Sans Text\", \"Google Sans\", Helvetica, Arial, sans-serif",
    "font.family_display": "\"Google Sans\", Roboto, Arial, sans-serif",
    "font.family_topbar": "\"Google Sans Text\", Roboto, Helvetica, Arial, sans-serif",
    "font.family_button": "\"Google Sans Flex\", \"Google Sans Text\", \"Google Sans\", Roboto, Arial, sans-serif",
    "font.effective_family_note": "gm3-light.json roles: body/sidebar/mini calendar/day names use Google Sans Text; the topbar title, month title and day numbers use Google Sans; Today/Week buttons use Google Sans Flex; icons use Google Material Icons.",
    "color.source_light": "measurements/gm3-light.json bodyBg + component dumps",
    "color.source_dark": "measurements/gm3-dark.json bodyBg + component dumps",
    "layout.source": "measurements/topbar-light.json, hour_grid-light.json",
    "font.body_size": "14px",
    "font.body_note": "body_size copied from measurements/gm3-light.json roles.body.fontSize",
    "color.light.body_text": "rgb(0, 0, 0)",
    "color.dark.body_text": "rgb(0, 0, 0)",
    "color.body_text_note": "body_text copied from measurements/gm3-light.json and gm3-dark.json roles.body.color (Google leaves body color black in both themes; every visible text sets its own color)",
    "layout.chip_width_factor": 1.7,
    "layout.chip_width_factor_note": "Derived from measurements/hour_grid-light.json: Overlap A 116.28px / column 136.80px × 2 columns = 1.70; Triple A 77.52px / 136.80px × 3 = 1.70. A chip in column i of n spans min(1.7/n, 1 − i/n) of the column width; left = i/n.",
    "layout.chip_height_gap": "2px",
    "layout.chip_height_gap_note": "measurements/hour_grid-light.json: Fifteen 13px, Thirty 28px, Forty-five 43px, Sixty 58px, Ninety 88px = minutes − 2px at 60px per hour.",
    "layout.week_initial_scroll": "420px",
    "layout.week_initial_scroll_note": "Probed on calendar.google.com (week view, 1440×900, Date shifted to 08:30, 10:00, 13:00, 15:30): the grid opens at scrollTop 420px (07:00) whenever the now line falls inside the visible window; at 19:29 (now line at 1169px, outside the window) it opened at the bottom (753px) and at 00:30 at 0px, which matches scrollTop = clamp(nowY − week_scroll_now_margin).",
    "component.week.tz_label.top": "86px",
    "component.week.tz_label_primary.top": "86px",
    "component.week.tz_label_note": "top copied from getComputedStyle on calendar.google.com (the label cells are position: relative; top 86px = header 84px + 2px), probed 2026-09-14 alongside measurements/hour_grid-light.json.",
    "component.week.gutter_label.top": "-6px",
    "component.week.gutter_label_note": "top copied from getComputedStyle (position: relative; top -6px) on calendar.google.com, probed 2026-09-14 alongside measurements/hour_grid-light.json.",
    "layout.main_gap_right": "16px",
    "layout.main_gap_bottom": "16px",
    "layout.main_gap_note": "measurements/hour_grid-light.json rootRect [256,64,1168,820] inside a 1440×900 viewport: 16px free on the right and at the bottom.",
    "layout.week_scroll_now_margin": "90px",
    "layout.week_scroll_now_margin_note": "See week_initial_scroll_note: the only out-of-window observations were clamped, so 90px is the smallest margin consistent with them (08:30: 510 − 420) and is applied only when the now line is outside the window.",
    "component.sidebar.list_check_path_on.stroke_width": "4px",
    "component.sidebar.list_check_path_on.stroke": "rgb(255, 255, 255)",
    "component.sidebar.list_check_path_note": "stroke and stroke-width read with getComputedStyle on the tick path of calendar.google.com (probed 2026-09-14); the unchecked tick is hidden with a dash offset equal to its length.",
    "component.week.line_after.margin_top": "-1px",
    "component.week.line_after_note": "getComputedStyle(cell, \"::after\") on calendar.google.com (2026-09-14): content \"\", position absolute, left/right 0, height 0, margin-top -1px, z-index 3, border-bottom 1px solid rgb(221, 227, 234) (same as lines.borderTop); the line of hour k lies at 60k px from the top of the row.",
    "component.week.body_inner_before.box_shadow": "rgba(0, 0, 0, 0.14) 0px 1px 1px 0px inset, rgba(0, 0, 0, 0.12) 0px 2px 1px -1px inset",
    "component.week.body_inner_before.height": "4px",
    "component.week.body_inner_before.left": "0px",
    "component.week.body_inner_before.right": "16px",
    "component.week.body_inner_before.z_index": "507",
    "component.week.body_inner_before_note": "getComputedStyle(bodyInner, \"::before\"): the shadow under the header row, absolute at top 0 inside .week-body (position relative), width 100% minus the 16px scrollbar gutter on the right.",
    "component.week.gutter_before.background_image": {
      "light": "linear-gradient(to right, rgb(255, 255, 255), rgba(255, 255, 255, 0))",
      "dark": "linear-gradient(to right, rgb(19, 19, 20), rgba(19, 19, 20, 0))"
    },
    "component.week.gutter_before.width": "80px",
    "component.week.gutter_before.height": "2px",
    "component.week.body_inner_after.background_image": {
      "light": "linear-gradient(to left, rgb(255, 255, 255), rgba(255, 255, 255, 0))",
      "dark": "linear-gradient(to left, rgb(19, 19, 20), rgba(19, 19, 20, 0))"
    },
    "component.week.body_inner_after.width": "80px",
    "component.week.body_inner_after.height": "2px",
    "component.week.body_inner_after.right": "16px",
    "component.week.fades_note": "getComputedStyle(gutter, \"::before\") and (bodyInner, \"::after\") on calendar.google.com, light and with prefers-color-scheme: dark emulated (2026-09-14): 2px-high fades over the header shadow at both ends, absolute at top 0, z-index 507.",
    "component.chip.stacked_after.border_top": {
      "light": "1px solid rgb(255, 255, 255)",
      "dark": "1px solid rgb(19, 19, 20)"
    },
    "component.chip.stacked_after.left": "-1px",
    "component.chip.stacked_after.top": "-1px",
    "component.chip.stacked_after.border_radius": "7px",
    "component.chip.stacked_after_note": "getComputedStyle(chip, \"::after\") on calendar.google.com (2026-09-14): chips in column 1+ of an overlap cluster carry a 1px outline in the surface colour (absolute, −1px/−1px, chip size + 2px, radius 7px); column 0 chips have none. The chip z-index is 5 + column (Triple A 5, B 6, C 7).",
    "layout.allday_row_min_height_note": "not measured: the reference week has all-day events in every dump (allday_row.md)"
  },
